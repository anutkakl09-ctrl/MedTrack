{
  "name": "medtrack-telegram-mini-app",
  "private": true,
  "version": "0.1.0",
  "description": "MedTrack — Telegram Mini App для учета приема лекарств",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web,bot,worker -c magenta,cyan,yellow,green \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:bot\" \"npm run dev:worker\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "dev:bot": "tsx watch server/bot.ts",
    "dev:worker": "tsx watch server/worker.ts",
    "start": "npm run build && tsx server/all.ts",
    "start:all": "tsx server/all.ts",
    "start:api": "tsx server/index.ts",
    "start:bot": "tsx server/bot.ts",
    "start:worker": "tsx server/worker.ts",
    "build:web": "vite build",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "format": "prettier --write .",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.23.15",
    "vite": "^6.4.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "concurrently": "^9.1.2",
    "eslint": "^9.26.0",
    "globals": "^17.13.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^3.1.3"
  }
}
